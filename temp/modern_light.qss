/* ===== Современная светлая тема (в духе Яндекс.Браузера) ===== */

/* Базовый шрифт и фон окна */
QWidget {
    background-color: #ffffff;
    color: #1a1a1a;
    font-family: 'Segoe UI', 'SF Pro Display', 'Inter', sans-serif;
    font-size: 14px;
}

/* Главное окно / контейнер */
QMainWindow, QDialog {
    background-color: #ffffff;
}

/* ===== Сайдбар (вертикальная панель слева) ===== */
QFrame#sidebar {
    background-color: #f5f5f7;
    border-right: 1px solid #e8e8e8;
}

QLabel#sidebar-title {
    color: #1a1a1a;
    font-size: 18px;
    font-weight: 600;
    padding: 20px 20px 12px 20px;
    background: transparent;
}

/* Кнопки сайдбара */
QPushButton#nav-btn {
    text-align: left;
    padding: 10px 20px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #5a5a5a;
    font-size: 14px;
}
QPushButton#nav-btn:hover {
    background-color: #ececef;
    color: #1a1a1a;
}
QPushButton#nav-btn:checked {
    background-color: #e0e0e5;
    color: #1a1a1a;
    font-weight: 500;
}

/* ===== Обычные кнопки ===== */
QPushButton {
    background-color: #ff4d4f;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #ff7875;
}
QPushButton:pressed {
    background-color: #d9363e;
}
QPushButton:disabled {
    background-color: #ccc;
    color: #888;
}

/* Вторичная кнопка */
QPushButton#secondary {
    background-color: #f0f0f3;
    color: #1a1a1a;
}
QPushButton#secondary:hover {
    background-color: #e0e0e5;
}
QPushButton#secondary:pressed {
    background-color: #d0d0d5;
}

/* ===== Поля ввода ===== */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #f5f5f7;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 10px 14px;
    color: #1a1a1a;
    font-size: 14px;
    selection-background-color: #ff4d4f;
    selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #ff4d4f;
    background-color: #ffffff;
    padding: 9px 13px;
}

/* ===== Чекбоксы ===== */
QCheckBox {
    spacing: 8px;
    color: #1a1a1a;
    font-size: 14px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #c4c4c4;
    border-radius: 5px;
    background-color: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #ff4d4f;
}
QCheckBox::indicator:checked {
    background-color: #ff4d4f;
    border-color: #ff4d4f;
    image: none;
}

/* ===== Скроллбар ===== */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c4c4c4;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c4c4c4;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ===== Выпадающие списки ===== */
QComboBox {
    background-color: #f5f5f7;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 10px 14px;
    color: #1a1a1a;
    font-size: 14px;
}
QComboBox:hover {
    border-color: #c4c4c4;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #f5f5f7;
    selection-color: #1a1a1a;
}

/* ===== Прогресс-бар ===== */
QProgressBar {
    background-color: #f0f0f3;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #5a5a5a;
    font-size: 12px;
    height: 12px;
}
QProgressBar::chunk {
    background-color: #ff4d4f;
    border-radius: 6px;
}

/* ===== Вкладки ===== */
QTabWidget::pane {
    border: none;
    border-bottom: 1px solid #e8e8e8;
}
QTabBar::tab {
    background: transparent;
    border: none;
    padding: 10px 20px;
    color: #5a5a5a;
    font-size: 14px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: #1a1a1a;
}
QTabBar::tab:selected {
    color: #1a1a1a;
    font-weight: 500;
    border-bottom: 2px solid #ff4d4f;
}

/* ===== Тултипы ===== */
QToolTip {
    background-color: #1a1a1a;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
}

/* ===== Меню ===== */
QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 24px;
    border-radius: 6px;
    color: #1a1a1a;
}
QMenu::item:selected {
    background-color: #f5f5f7;
}
QMenu::separator {
    height: 1px;
    background: #e8e8e8;
    margin: 4px 8px;
}

/* ===== Заголовок приложения ===== */
QLabel#header {
    font-size: 24px;
    font-weight: 700;
    color: #1a1a1a;
    padding: 0;
    background: transparent;
}
QLabel#subheader {
    font-size: 14px;
    color: #888888;
    padding: 0;
    background: transparent;
}

/* ===== Карточка ===== */
QFrame#card {
    background-color: #f5f5f7;
    border-radius: 12px;
    border: none;
}
