/* Базовые настройки */
* {
    font-family: "Segoe UI", "Roboto", "Arial", sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: #F3F4F6;
    color: #111827;
}

/* Сайдбар — как панель навигации Windows 11 */
QWidget#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #D1D5DB;
}

/* Карточка — как окно приложения Windows 11 */
QWidget#card {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 20px;
}

/* Кнопки навигации — акцент при наведении и выборе */
QPushButton#navButton {
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: #4B5563;
}
QPushButton#navButton:hover {
    background-color: #E5F3FF;
    color: #1E40AF;
}
QPushButton#navButton:checked {
    background-color: #C9EEFF;
    color: #0E488F;
    border: 1px solid #B0D7FF;
}

/* Поля ввода — стиль Windows 11 TextBox */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 8px 12px;
    color: #111827;
}
QLineEdit:focus {
    border: 1px solid #3B82F6;
    background-color: #FAFAFA;
}

/* Выпадающий список */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 6px 12px;
    padding-right: 28px;
    color: #111827;
    selection-background-color: #3B82F6;
}
QComboBox:hover {
    border-color: #3B82F6;
}
QComboBox:focus {
    border: 1px solid #3B82F6;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #6B7280;
    margin-right: 10px;
}
QComboBox::down-arrow:hover {
    border-top-color: #111827;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
    outline: none;
    padding: 4px;
}

/* new */
/* Выпадающий список QComboBox */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 10px;
    border-radius: 6px;
    margin: 2px 2px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #E5F3FF;
    color: #1E40AF;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}

/* Чекбокс */
QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:checked {
    background-color: #3B82F6;
    border: 1px solid #2563EB;
}

/* Основные кнопки — как в Windows 11 (акцентные) */
QPushButton#primaryButton {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#primaryButton:hover {
    background-color: #2563EB;
}
QPushButton#primaryButton:pressed {
    background-color: #1D4ED8;
}
QPushButton#primaryButton:disabled {
    background-color: #E5E7EB;
    color: #9CA3AF;
}
QPushButton#primaryButton:focus {
    border: 2px solid #93C5FD;
}

/* Вторичные кнопки — спокойные */
QPushButton#secondaryButton {
    background-color: transparent;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}
QPushButton#secondaryButton:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}
QPushButton#secondaryButton:pressed {
    background-color: #E5E7EB;
}
QPushButton#secondaryButton:disabled {
    color: #9CA3AF;
    border-color: #E5E7EB;
}

/* Прогресс-бар — стиль Windows 11 ProgressBar */
QProgressBar {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    background-color: #F3F4F6;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #3B82F6;
    border-radius: 6px;
}

/* Скроллбар — тонкий, как в Windows 11 */
QScrollBar:vertical {
    width: 10px;
    background: transparent;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
